{
  "name": "exposed-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "index.ts",
  "bin": {
    "exposed": "bin/cli.js"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:server && EXPO_NO_TYPESCRIPT_SETUP=1 expo export --platform web",
    "dev": "EXPO_NO_TYPESCRIPT_SETUP=1 expo start --web",
    "test": "npm run build:server && node --test build/server/*.test.js",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/prepare-pty.mjs",
    "prepack": "npm run build && node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "@expo/metro-runtime": "~57.0.16",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "expo": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "license": "Unlicense",
  "description": "A local command and device dashboard for Expo projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tindn/exposed-ui.git"
  },
  "homepage": "https://github.com/tindn/exposed-ui#readme",
  "bugs": {
    "url": "https://github.com/tindn/exposed-ui/issues"
  },
  "files": [
    "bin/",
    "build/server/**/*.js",
    "build/shared/**/*.js",
    "!build/**/*.test.js",
    "dist/",
    "scripts/prepare-pty.mjs",
    "UNLICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ]
}
